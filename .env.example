POSTGRES_DB=torob_hakatoon
POSTGRES_USER=torob
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=15432
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
BACKEND_PORT=8000
FRONTEND_PORT=5000
# Backend-only chatbot settings. Never prefix secrets with VITE_.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AGENT_TURN_TIMEOUT_SECONDS=90
# First owner of the custom panel; bootstrap_panel never resets existing accounts.
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=

# Public basemap style URL; no API key required.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Reverse geocoding (public Photon; fair use, cached and rate-limited).
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_USER_AGENT=TorobHamrah/1.0 (+https://github.com/amirhosseinpourmoshir/torob-challenge)

# Production compose: set ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS above to your domain.
SERVER_BIND=0.0.0.0
WEB_CONCURRENCY=2
WEB_THREADS=4
# Enable only when serving behind HTTPS.
COOKIE_SECURE=false

# Liara CLI deployment (local only; never exposed to the browser).
# Team ID, not the console URL. Get it from Liara team settings or `liara team list`.
LIARA_TEAM_ID=
# Optional when already logged in with `liara login`.
LIARA_API_TOKEN=
# Fill after selecting/creating the Docker app in this team.
LIARA_APP_ID=
LIARA_PUBLIC_HOST=
# Managed PostgreSQL connection; separate from the local Docker database.
LIARA_POSTGRES_HOST=
LIARA_POSTGRES_PORT=5432
LIARA_POSTGRES_DB=torob_hakatoon
LIARA_POSTGRES_USER=
LIARA_POSTGRES_PASSWORD=
